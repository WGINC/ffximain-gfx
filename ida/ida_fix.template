"""ffxi_ida_fix.py -- one self-contained pass in IDA 9.4: apply the pipeline's pending data, correct IDA's
stack pointer from measured depths, and re-export the graphics functions.

Generated by pipeline/make_ida_fix.py; the data it needs is embedded below, so this one file can be run
from anywhere: open the FFXiMain_unpacked.dll IDB (save it first, or use a copy), then
File > Script file... > ffxi_ida_fix.py. Steps:
  1. names: names_pending_idb.json (only where the IDB still has the expected placeholder name);
  2. prototypes: type_fixes.json;
  3. the viewport globals 0x104E1B70 and 0x10621904 typed D3DVIEWPORT8 (24 bytes, not pointers);
  4. stack pointer: SP points set by the first version of this script where its measurement was wrong are
     removed (IDA's own analysis returns). Then, at each call whose stack effect is known exactly -- measured
     from real code (pipeline/real_sp.py) or solved from the caller's own stack balance at every `ret` and
     every join (pipeline/sp_solve.py, which recovers 20001 of 20002 hidden `ret N` values and rejects the
     function behind the one it gets wrong) -- and differs from IDA's, a user SP change point is set (what
     Alt+K does), checked by reading IDA's SP back;
  4b. call types: at indirect calls where the bytes pushed just before differ from what the callee (seen
     running) pops, Hex-Rays guesses the arguments wrong; the call type is forced to the callee's prototype
     (rebuilt with the measured argument count when its own disagrees), verified by decompiling;
  5. re-export: every function of the current export is decompiled again, each with its call sites
     (Hex-Rays' argument count and calling convention per call) and IDA's stack pointer where it changes.
Output, next to the IDB: gfx_export.jsonl, ida_fix_report.json and ida_fix_log.txt. Each step
runs even if an earlier one failed; failures are logged with their traceback.
"""
import json, os, re, sys, time, traceback
import idc, idaapi, ida_auto, ida_bytes, ida_frame, ida_funcs, ida_hexrays, ida_kernwin, ida_lines, ida_nalt
import ida_name, ida_typeinf, idautils

DATA = json.loads(r'''__DATA__''')
OUT_DIR = os.path.dirname(idc.get_idb_path()) or os.getcwd()
LOG = []
VIEWPORT_DECL = 'struct D3DVIEWPORT8 { unsigned int X; unsigned int Y; unsigned int Width; unsigned int Height; float MinZ; float MaxZ; };'


def log(*a):
    s = ' '.join(str(x) for x in a); LOG.append(s); print(s)


def add_note(ea, note):
    func = idc.get_func_attr(ea, idc.FUNCATTR_START) == ea
    old = (idc.get_func_cmt(ea, 0) if func else idc.get_cmt(ea, 0)) or ''
    if note not in old:
        new = (old + '\n' + note).strip()
        idc.set_func_cmt(ea, new, 0) if func else idc.set_cmt(ea, new, 0)


# ------------------------------------------------------------------ 0: facts from the code, as function comments
def apply_facts():
    n = 0
    for k, notes in DATA.get('facts', {}).items():
        ea = int(k, 16)
        if idc.get_func_attr(ea, idc.FUNCATTR_START) != ea: continue
        add_note(ea, '[gfx-recon facts 2026-10-21] ' + '; '.join(notes)); n += 1
    log('facts: %d functions annotated' % n)


# ------------------------------------------------------------------ 1-3: names, prototypes, viewports
def apply_names():
    done, skipped = 0, []
    for k, v in DATA['names'].items():
        ea = int(k, 16); cur = ida_name.get_name(ea)
        if cur == v['name']: continue
        if cur != v['old'] or not ida_name.set_name(ea, v['name'], ida_name.SN_NOWARN | ida_name.SN_NOCHECK):
            skipped.append((k, cur, v['name'])); continue
        add_note(ea, v.get('note') or '[name %s 2026-10-02, %s confidence, from the code and the IDA listing] %s'
                 % (v['name'], v['confidence'], v['evidence']))
        done += 1
    log('names: %d applied, %d skipped' % (done, len(skipped)))
    for s in skipped: log('  skipped %s: IDB has %r, wanted %r' % s)


def apply_types():
    done = 0
    for k, v in DATA['types'].items():
        ea = int(k, 16); nm = ida_name.get_name(ea) or 'f'; t = v['type']
        if '(' in t: decl = t.replace('(', ' %s(' % nm, 1) + ';'
        elif '[' in t: decl = t.replace('[', ' %s[' % nm, 1) + ';'
        else: decl = '%s %s;' % (t, nm)
        if not idc.SetType(ea, decl):
            log('  prototype failed %s: %s' % (k, decl)); continue
        add_note(ea, '[type 2026-10-02] %s %s' % (v['why'], v['evidence'])); done += 1
    log('prototypes: %d applied' % done)


def apply_viewports():
    for g in (0x104E1B70, 0x10621904):
        ok = idc.SetType(g, 'D3DVIEWPORT8;')
        if not ok:
            idc.parse_decls(VIEWPORT_DECL, 0)
            ok = idc.SetType(g, 'D3DVIEWPORT8;')
        log('viewport global 0x%X typed D3DVIEWPORT8: %s' % (g, bool(ok)))


# ------------------------------------------------------------------ 2b: conventions
def fix_conventions(report):
    """functions the IDB declares __stdcall that use their entry ECX (vcall_resolve.py reads it from the code:
    `mov edx, ecx`, `add ecx, 178h`, ...): retyped __thiscall with `this` added in ECX, keeping the stack
    arguments, only where those already match the function's own `ret N`"""
    done = 0
    for k, purge in sorted(DATA['conv_fix'].items()):
        ea = int(k, 16); t = ida_typeinf.tinfo_t(); res = {'name': ida_name.get_name(ea)}
        report['conventions'][k] = res
        if not ida_nalt.get_tinfo(t, ea) or not t.is_func(): res['result'] = 'no prototype'; continue
        fd = ida_typeinf.func_type_data_t(); t.get_func_details(fd); cc = cc_name(fd); res['was'] = str(t)
        if cc in ('thiscall', 'fastcall'): res['result'] = 'already ' + cc; continue
        if cc != 'stdcall' or stack_bytes(fd) != purge:
            res['result'] = 'left: %s with %d stack bytes, ret %d' % (cc, stack_bytes(fd), purge); continue
        nfd = ida_typeinf.func_type_data_t()
        nfd.rettype = fd.rettype
        try: nfd.set_cc(ida_typeinf.CM_CC_THISCALL)
        except Exception: nfd.cc = ida_typeinf.CM_CC_THISCALL
        me = ida_typeinf.funcarg_t(); me.name = 'self'; pv = ida_typeinf.tinfo_t(); pv.create_ptr(ida_typeinf.tinfo_t(ida_typeinf.BT_VOID))
        me.type = pv; nfd.push_back(me)
        for a in fd: nfd.push_back(a)
        nt = ida_typeinf.tinfo_t()
        if not nt.create_func(nfd) or not ida_typeinf.apply_tinfo(ea, nt, ida_typeinf.TINFO_DEFINITE):
            res['result'] = 'not applied'; continue
        t2 = ida_typeinf.tinfo_t(); ida_nalt.get_tinfo(t2, ea); fd2 = ida_typeinf.func_type_data_t(); t2.get_func_details(fd2)
        res['now'] = str(t2); res['result'] = 'thiscall' if cc_name(fd2) == 'thiscall' else 'did not take'
        if res['result'] == 'thiscall':
            done += 1; add_note(ea, '[conv 2026-10-03] __thiscall: the code uses its entry ECX (%s)' % DATA['conv_why'].get(k, ''))
            ida_hexrays.mark_cfunc_dirty(ea)
        log('convention %s %s: %s' % (k, res['name'], res['result']))
    log('conventions: %d of %d retyped __thiscall' % (done, len(DATA['conv_fix'])))


# ------------------------------------------------------------------ 3b: class types (make_ida_types.py)
def fnptr_decl(target, member):
    """a vtable member typed as a pointer to the target's own IDB prototype, or `void *` where it cannot be"""
    t = idc.get_type(target) or ''
    m = re.match(r'^(.*?)\s*(__cdecl|__stdcall|__thiscall|__fastcall)\s*\((.*)\)\s*$', t)
    if not m or '(' in m.group(1): return 'void *%s;' % member
    return '%s (%s *%s)(%s);' % (m.group(1), m.group(2), member, m.group(3))


def vtbl_decl(cname, c):
    return 'struct %s_vtbl { %s };' % (cname, ' '.join(
        fnptr_decl(int(t, 16), 'vf%d_%s' % (k, re.sub(r'\W', '_', ida_name.get_name(int(t, 16)) or 'vf'))) for k, t in enumerate(c['slots'])))


def extend_existing(cname, c, t):
    """a class the IDB already declares: its vtable pointer (an untyped dword or void pointer at offset 0) typed as
    a pointer to the vtable struct, and the proven fields placed where the IDB's type has no member or only a
    byte-array placeholder (`_pad_*` / `gap*`; the placeholder keeps the bytes the field does not use, under its
    own name, so no other member moves). Every other member is left as it is; a field inside one (a base-class
    member, a typed array) is not added and is counted."""
    udt = ida_typeinf.udt_type_data_t()
    if not t.get_udt_details(udt): return 'not a struct'
    out = []
    vt = ida_typeinf.tinfo_t()
    if not vt.get_named_type(None, cname + '_vtbl'):
        if idc.parse_decls(vtbl_decl(cname, c), idc.PT_SILENT):
            idc.parse_decls('struct %s_vtbl { %s };' % (cname, ' '.join('void *vf%d;' % k for k in range(len(c['slots'])))), idc.PT_SILENT)
            out.append('vtable members untyped')
        vt.get_named_type(None, cname + '_vtbl')
    mem = list(udt)                                # references into udt, which is not changed below
    m0 = [m for m in mem if m.offset == 0 and m.size == 32]
    if m0 and not str(m0[0].type).endswith('_vtbl *') and (m0[0].type.is_ptr() or m0[0].type.get_size() == 4):
        pv = ida_typeinf.tinfo_t(); pv.create_ptr(vt); m0[0].type = pv; out.append('vftable typed')
    elif not (m0 and str(m0[0].type).endswith('_vtbl *')): out.append('offset 0 is %s %s' % (str(mem[0].type) if mem else '-', mem[0].name if mem else '-'))
    def pad(m):
        return (m.name.startswith('_pad_') or m.name.startswith('gap')) and m.type.is_array() \
            and m.type.get_array_element().get_size() == 1
    free = [[m.offset // 8, (m.offset + m.size) // 8, m] for m in mem if pad(m)]
    keep = [m for m in mem if not pad(m)]
    taken = [(m.offset // 8, (m.offset + m.size) // 8) for m in keep]
    added = inside = 0; placed = []
    for off, size, ty in c['fields']:
        off = int(off, 16)
        if any(a < off + size and off < b for a, b in taken): inside += 1; continue
        tif = ida_typeinf.tinfo_t()
        if ida_typeinf.parse_decl(tif, None, '%s x;' % ty, ida_typeinf.PT_SIL) is None: continue
        u = ida_typeinf.udm_t(); u.name = 'field_%X' % off; u.type = tif; u.offset = off * 8; u.size = size * 8
        keep.append(u); taken.append((off, off + size)); placed.append((off, off + size)); added += 1
    if added or 'vftable typed' in out:
        for a, b, m in (x for x in free if x[2].name.startswith('_pad_')):   # what is left of each placeholder
            cuts = sorted(x for x in placed if a <= x[0] < b)
            pos = a
            for x0, x1 in cuts + [(b, b)]:
                if x0 > pos:
                    p = ida_typeinf.udm_t(); p.name = m.name if pos == a else '%s_%X' % (m.name, pos)
                    p.type = ida_typeinf.tinfo_t(); p.type.create_array(m.type.get_array_element(), x0 - pos)
                    p.offset = pos * 8; p.size = (x0 - pos) * 8; keep.append(p)
                pos = max(pos, x1)
        keep.sort(key=lambda m: m.offset)
        nu = ida_typeinf.udt_type_data_t()
        for m in keep: nu.push_back(m)
        nu.total_size = udt.total_size; nu.pack = udt.pack
        nt = ida_typeinf.tinfo_t()
        if not nt.create_udt(nu, ida_typeinf.BTF_STRUCT) or nt.set_named_type(None, cname, ida_typeinf.NTF_REPLACE) != 0:
            return 'not changed (the edited type was refused)'
        idc.SetType(int(c['vtable'], 16), '%s_vtbl;' % cname)
    out.append('%d fields added' % added)
    if inside: out.append('%d inside an existing member' % inside)
    return '; '.join(out)


ART = re.compile(r'\*\s*\(\s*\(?\s*_(?:BYTE|WORD|DWORD|QWORD)\s*\*\s*\)|\(__\w+ \*\*\)|\b(?:S?LO|S?HI)(?:BYTE|WORD|DWORD)\s*\(|\bS?(?:BYTE|WORD)\d\s*\(')


def artifacts(ea):
    """casts, cast vtable calls and partial-register macros in the function's pseudocode now
    (pipeline/artifact_count.py's cast, untyped_vcall and partial_reg kinds); None if it does not decompile"""
    try:
        ida_hexrays.mark_cfunc_dirty(ea); cf = ida_hexrays.decompile(ea)
        return len(ART.findall(str(cf))) if cf else None
    except Exception:
        return None


def apply_classes(report):
    """structs for classes whose methods' `this` the code proves to hold one vtable: a vtable struct (members typed
    as the slot functions' own prototypes), fields at every offset the methods access at one width, `this`
    typed on those methods. A type the IDB already has under the name is kept as it is."""
    rep = report.setdefault('classes', {}); made = typed = 0
    for cname, c in sorted(DATA['classes'].items()):
        r = rep[cname] = {}
        old = ida_typeinf.tinfo_t()
        if old.get_named_type(None, cname):
            r['struct'] = 'kept the IDB\'s own type'
            try: r['extended'] = extend_existing(cname, c, old)
            except Exception: r['extended'] = 'failed: ' + traceback.format_exc().splitlines()[-1]
        else:
            seen, slots = set(), []
            for k, t in enumerate(c['slots']):
                nm = re.sub(r'\W', '_', ida_name.get_name(int(t, 16)) or 'vf')
                nm = 'vf%d_%s' % (k, nm)
                slots.append(fnptr_decl(int(t, 16), nm))
            body, pos = ['struct %s_vtbl *vftable;' % cname], 4
            for off, size, ty in c['fields']:
                off = int(off, 16)
                if off > pos: body.append('unsigned __int8 gap_%X[%d];' % (pos, off - pos))
                body.append('%s field_%X;' % (ty, off)); pos = off + size
            vt = 'struct %s_vtbl { %s };' % (cname, ' '.join(slots))
            decl = 'struct %s_vtbl; %s struct %s { %s };' % (cname, vt, cname, ' '.join(body))
            errs = idc.parse_decls(decl, idc.PT_SILENT)
            if errs:
                vt = 'struct %s_vtbl { %s };' % (cname, ' '.join('void *vf%d;' % k for k in range(len(c['slots']))))
                errs = idc.parse_decls('struct %s_vtbl; %s struct %s { %s };' % (cname, vt, cname, ' '.join(body)), idc.PT_SILENT)
                r['vtable_members'] = 'untyped (the slot prototypes did not parse)'
            if errs: r['struct'] = 'not created (%d errors)' % errs; log('class %s: not created' % cname); continue
            made += 1; r['struct'] = 'created: %d fields, %d slots' % (len(c['fields']), len(c['slots']))
            idc.SetType(int(c['vtable'], 16), '%s_vtbl;' % cname)
        ct = ida_typeinf.tinfo_t()
        if not ct.get_named_type(None, cname): continue
        pt = ida_typeinf.tinfo_t(); pt.create_ptr(ct); r['methods'] = {}
        for m in c['methods']:
            ea = int(m, 16); t = ida_typeinf.tinfo_t()
            if not ida_nalt.get_tinfo(t, ea) or not t.is_func(): r['methods'][m] = 'no prototype'; continue
            fd = ida_typeinf.func_type_data_t(); t.get_func_details(fd)
            if cc_name(fd) != 'thiscall' or fd.size() == 0: r['methods'][m] = 'left: not __thiscall'; continue
            fd[0].type = pt; nt = ida_typeinf.tinfo_t()
            pre = DATA['pre_class_types'].get(m)
            if pre and str(t).find(cname + ' *') >= 0 and idc.SetType(ea, re.sub(r'^(.*?)\(', r'\1 f(', pre, 1) + ';'):
                t = ida_typeinf.tinfo_t(); ida_nalt.get_tinfo(t, ea)     # typed by an earlier run: measure against the type before it
            before = artifacts(ea)
            if nt.create_func(fd) and ida_typeinf.apply_tinfo(ea, nt, ida_typeinf.TINFO_DEFINITE):
                ida_hexrays.mark_cfunc_dirty(ea); after = artifacts(ea)
                if before is not None and after is not None and after > before:
                    # measured, not assumed: the typed `this` made this function's pseudocode worse
                    ida_typeinf.apply_tinfo(ea, t, ida_typeinf.TINFO_DEFINITE); ida_hexrays.mark_cfunc_dirty(ea)
                    r['methods'][m] = 'reverted: artifacts rose %d -> %d with this: %s *' % (before, after, cname); continue
                typed += 1; r['methods'][m] = 'this: %s * (artifacts %s -> %s)' % (cname, before, after)
            else: r['methods'][m] = 'not applied'
    log('classes: %d structs created, %d methods given a typed this (of %d classes, %d methods)' % (
        made, typed, len(DATA['classes']), sum(len(c['methods']) for c in DATA['classes'].values())))


# ------------------------------------------------------------------ 4: stack pointer
def change_at(call):
    nxt = call + idc.get_item_size(call)
    a, b = idc.get_spd(call), idc.get_spd(nxt)
    return None if a is None or b is None else b - a    # IDA's SP falls as the stack grows: a pop is positive


def set_change(call, value):
    nxt = call + idc.get_item_size(call); pfn = ida_funcs.get_func(call)
    ida_frame.del_stkpnt(pfn, nxt)
    ida_frame.add_user_stkpnt(nxt, value)
    ida_funcs.reanalyze_function(pfn); ida_auto.auto_wait()
    return change_at(call)


def revert(report):
    """undo SP points an earlier version of this script set from a gate model that was wrong there"""
    for k in DATA['revert']:
        call = int(k, 16); pfn = ida_funcs.get_func(call)
        if not pfn: continue
        ida_frame.del_stkpnt(pfn, call + idc.get_item_size(call))
        ida_funcs.reanalyze_function(pfn); ida_auto.auto_wait()
        if (idc.get_cmt(call, 0) or '').startswith('[sp fix'): idc.set_cmt(call, '', 0)
        ida_hexrays.mark_cfunc_dirty(pfn.start_ea)
        report['reverted'][k] = change_at(call)
        log('SP point removed at %s: IDA now says the call changes SP by %s' % (k, change_at(call)))


def fix_sp(report):
    """at each call whose stack effect is known exactly, make IDA agree: measured from real code (the callee's
    own `ret N`, real_sp.py) or solved from the caller's stack balance (sp_solve.py, self-tested)"""
    funcs = DATA['sp_calls']; n = 0
    for fk, rec in funcs.items():
        n += 1
        if ida_kernwin.user_cancelled(): log('SP: cancelled'); break
        if n % 25 == 0: ida_kernwin.replace_wait_box('SP check %d of %d' % (n, len(funcs)))
        f = int(fk, 16)
        if not ida_funcs.get_func(f): continue
        # every differing call of the function first, then one reanalysis (not one per call), then each is
        # read back; a call that did not take is retried alone with the other sign, then left to IDA
        todo = []
        for ck, real in sorted(rec['calls'].items()):
            call = int(ck, 16); had = change_at(call)
            STATS['sp_checked'] = STATS.get('sp_checked', 0) + 1
            if had is None: STATS['sp_unreadable'] = STATS.get('sp_unreadable', 0) + 1
            elif had == real: STATS['sp_already_right'] = STATS.get('sp_already_right', 0) + 1
            else: todo.append((ck, call, real, had))
        if not todo: continue
        pfn = ida_funcs.get_func(f)
        for ck, call, real, had in todo:
            nxt = call + idc.get_item_size(call)
            ida_frame.del_stkpnt(pfn, nxt); ida_frame.add_user_stkpnt(nxt, real)
        ida_funcs.reanalyze_function(pfn); ida_auto.auto_wait()
        fixes = []
        for ck, call, real, had in todo:
            got = change_at(call)
            if got != real: got = set_change(call, -real)     # the other sign convention
            if got != real:                                   # neither took: leave IDA's own analysis in place
                ida_frame.del_stkpnt(pfn, call + idc.get_item_size(call))
                ida_funcs.reanalyze_function(pfn); ida_auto.auto_wait(); got = change_at(call)
            fixes.append({'call': ck, 'ida_change_was': had, 'real_change': real, 'now': got})
            if got != real: continue
            idc.set_cmt(call, '[sp fix 2026-10-03] this call changes SP by %d (%s); IDA had %d' % (
                real, rec['why'].get(ck, 'exact'), had), 0)
        if not fixes: continue
        ida_hexrays.mark_cfunc_dirty(f)
        bad = sum(1 for x in fixes if x['now'] != x['real_change'])
        report['sp'][fk] = {'name': idc.get_func_name(f), 'fixes': fixes, 'not_corrected': bad}
        log('SP %s %s: %d calls corrected%s' % (fk, idc.get_func_name(f), len(fixes) - bad, (', %d could not be' % bad) if bad else ''))
    log('SP: %d calls checked, %d already right, %d unreadable (IDA has no SP there); %d functions corrected' % (
        STATS.get('sp_checked', 0), STATS.get('sp_already_right', 0), STATS.get('sp_unreadable', 0), len(report['sp'])))


# ------------------------------------------------------------------ 4b: call types
def stack_bytes(fd):
    n = 0
    for i in range(fd.size()):
        a = fd[i]
        try: on_stack = a.argloc.is_stkoff()
        except Exception: on_stack = True
        if on_stack: n += (a.type.get_size() + 3) & ~3
    return n


def call_args(fea, call):
    """the number of arguments Hex-Rays gives the call at `call` (None if not found)"""
    try:
        ida_hexrays.mark_cfunc_dirty(fea)
        cf = ida_hexrays.decompile(fea, flags=ida_hexrays.DECOMP_NO_CACHE)
    except Exception:
        return None
    found = []

    class V(ida_hexrays.ctree_visitor_t):
        def __init__(s): super().__init__(ida_hexrays.CV_FAST)
        def visit_expr(s, e):
            if e.op == ida_hexrays.cot_call and e.ea == call: found.append(e.a.size())
            return 0
    if cf: V().apply_to(cf.body, None)
    return found[0] if found else None


def call_type_for(target, pops, thiscall=None):
    """the callee's own prototype if its stack arguments match what it pops (and its convention matches the
    callee's proven use of ECX, when known), else one built from the pops and that convention; with neither
    a matching prototype nor a known convention, nothing (None): the convention is not guessed"""
    t = ida_typeinf.tinfo_t()
    have = ida_nalt.get_tinfo(t, target)
    fd = ida_typeinf.func_type_data_t(); ret = 'int'
    if have and t.is_func() and t.get_func_details(fd):
        own = (cc_name(fd) == 'thiscall')
        if stack_bytes(fd) == pops and (thiscall is None or own == thiscall): return t, own
        if not fd.rettype.is_floating(): ret = str(fd.rettype)
        if thiscall is None: thiscall = own
    if thiscall is None: return None, None
    decl = '%s __%s f(%s);' % (ret, 'thiscall' if thiscall else 'stdcall',
                              ', '.join((['void *self'] if thiscall else []) + ['int a%d' % i for i in range(pops // 4)]) or 'void')
    nt = ida_typeinf.tinfo_t()
    if ida_typeinf.parse_decl(nt, None, decl, ida_typeinf.PT_SIL) is None: return None, thiscall
    return nt, thiscall


def call_type_jobs():
    """(function, call, spec): measured call types (real_sp.py), virtual calls proven by vtable
    (vcall_resolve.py: every possible callee agrees on its pop and on its use of ECX), and D3D8 method calls on
    a proven object (com_calls.py: the method's declaration from the D3D8 header)"""
    for fk, rec in DATA['real_sp'].items():
        for ck, v in sorted(rec.get('call_types', {}).items()): yield fk, ck, dict(v, ecx=None)
    for ck, v in sorted(DATA['vcall_types'].items()): yield v['func'], ck, v
    for ck, v in sorted(DATA.get('com_types', {}).items()): yield v['func'], ck, v


def force_call_types(report):
    for fk, ck, v in call_type_jobs():
            call = int(ck, 16); f = int(fk, 16)
            if v.get('decl'):                       # a COM method: its declaration from the D3D spec
                tif = ida_typeinf.tinfo_t(); thiscall = False
                if ida_typeinf.parse_decl(tif, None, v['decl'], ida_typeinf.PT_SIL) is None: tif = None
            else:
                tif, thiscall = call_type_for(int(v['targets'][0], 16), v['pops'], v.get('ecx'))
            want = v['pops'] // 4 + (1 if thiscall else 0)
            before = call_args(f, call)
            res = {'function': idc.get_func_name(f), 'target': v['targets'][0] if v['targets'] else v.get('decl'), 'args_before': before, 'args_wanted': want}
            if tif is None: res['result'] = 'no type'; report['call_types'][ck] = res; continue
            if before == want: res['result'] = 'already right'; report['call_types'][ck] = res; continue
            ptr = ida_typeinf.tinfo_t(); ptr.create_ptr(tif)
            ways = [('set_op_tinfo(ptr)', lambda: ida_nalt.set_op_tinfo(call, 0, ptr)),
                    ('set_op_tinfo(func)', lambda: ida_nalt.set_op_tinfo(call, 0, tif)),
                    ('apply_tinfo', lambda: ida_typeinf.apply_tinfo(call, tif, ida_typeinf.TINFO_DEFINITE)),
                    ('apply_callee_tinfo', lambda: ida_typeinf.apply_callee_tinfo(call, tif))]
            res['result'] = 'not taken'
            for name, way in ways:
                try: way()
                except Exception as e:
                    log('  call type %s via %s: %s' % (ck, name, e)); continue
                got = call_args(f, call)
                if got == want:
                    res['result'] = 'forced via ' + name; break
                try: ida_nalt.del_op_tinfo(call, 0)
                except Exception: pass
            res['args_after'] = call_args(f, call)
            report['call_types'][ck] = res
            log('call type %s in %s: %s args -> %s (%s)' % (ck, res['function'], before, res['args_after'], res['result']))


# ------------------------------------------------------------------ 5: re-export (same records as ida_gfx.export_one)
BAD = re.compile(r'__usercall|__userpurge|JUMPOUT|__asm|__spoils|BUG\(\)|__halt|_UNKNOWN|MEMORY\[|'
                 r'__readfsdword|__writefsdword|__outbyte|__inbyte|__CFSHL__|__SEH_|__try|__except')


def type_decl_closure(t, acc):
    try:
        if t.is_ptr() or t.is_array():
            type_decl_closure(t.get_pointed_object() if t.is_ptr() else t.get_array_element(), acc); return
        if t.is_func():
            fd = ida_typeinf.func_type_data_t()
            if t.get_func_details(fd):
                type_decl_closure(fd.rettype, acc)
                for a in fd: type_decl_closure(a.type, acc)
            return
        n = t.get_type_name()
        if n and n not in acc and (t.is_struct() or t.is_union() or t.is_enum() or t.is_typedef()):
            acc.add(n)
            if t.is_struct() or t.is_union():
                udt = ida_typeinf.udt_type_data_t()
                if t.get_udt_details(udt):
                    for m in udt: type_decl_closure(m.type, acc)
    except Exception:
        pass


def cc_name(fd):
    try: cc = fd.get_cc()
    except Exception: cc = getattr(fd, 'cc', 0)
    return {ida_typeinf.CM_CC_CDECL: 'cdecl', ida_typeinf.CM_CC_STDCALL: 'stdcall', ida_typeinf.CM_CC_THISCALL: 'thiscall',
            ida_typeinf.CM_CC_FASTCALL: 'fastcall'}.get(cc & ida_typeinf.CM_CC_MASK, 'other')


STATS = {}         # per-feature counts of the re-export, logged at the end (an empty feature shows as 0)
CMPS = {ida_hexrays.cot_slt: ('<', 1), ida_hexrays.cot_sle: ('<=', 1), ida_hexrays.cot_sgt: ('>', 1),
        ida_hexrays.cot_sge: ('>=', 1), ida_hexrays.cot_ult: ('<', 0), ida_hexrays.cot_ule: ('<=', 0),
        ida_hexrays.cot_ugt: ('>', 0), ida_hexrays.cot_uge: ('>=', 0)}
FCMPS = {ida_hexrays.cot_slt: '<', ida_hexrays.cot_sle: '<=', ida_hexrays.cot_sgt: '>', ida_hexrays.cot_sge: '>=',
         ida_hexrays.cot_ult: '<', ida_hexrays.cot_ule: '<=', ida_hexrays.cot_ugt: '>', ida_hexrays.cot_uge: '>=',
         ida_hexrays.cot_eq: '==', ida_hexrays.cot_ne: '!='}


def export_one(ea):
    rec = {'ea': ea, 'name': ida_name.get_name(ea), 'type': idc.get_type(ea) or ''}
    try:
        ida_hexrays.mark_cfunc_dirty(ea)
        cf = ida_hexrays.decompile(ea, flags=ida_hexrays.DECOMP_NO_CACHE)
    except Exception as e:
        cf = None; rec['error'] = str(e)
    if not cf:
        rec['skip'] = 'decompile failed'; return rec
    text = str(cf); rec['text'] = text
    m = BAD.search(text)
    if m: rec['skip'] = 'unsupported construct ' + m.group(0)
    objs = {}; types = set(); calls = {}; cmps = []; fcmps = []; cmp_err = [0]

    class V(ida_hexrays.ctree_visitor_t):
        def __init__(s): super().__init__(ida_hexrays.CV_FAST)
        def visit_expr(s, e):
            if e.op == ida_hexrays.cot_call and e.ea != idaapi.BADADDR:
                # the call's argument count and convention as Hex-Rays decompiled it (the gate's exact count
                # for a call through a fuzzed object)
                ft = e.x.type
                if ft.is_ptr(): ft = ft.get_pointed_object()
                fd = ida_typeinf.func_type_data_t(); cc = 'unknown'
                try:
                    if ft.get_func_details(fd): cc = cc_name(fd)
                except Exception: pass
                # where the type came from: 'typed' when the callee expression carries a declared type
                # (a struct member such as `lpVtbl->LockRect`, a named function), 'cast' when Hex-Rays had to
                # invent the pointer type from the call site (`(*(int (__stdcall **)(int, int))(*v + 36))`)
                x = e.x; src = 'typed'
                while x is not None and x.op in (ida_hexrays.cot_ptr, ida_hexrays.cot_cast):
                    if x.op == ida_hexrays.cot_cast: src = 'cast'; break
                    x = x.x
                calls['0x%08X' % e.ea] = [e.a.size(), cc, src]
            if e.op in CMPS and e.ea != idaapi.BADADDR and not (e.x.type.is_floating() or e.y.type.is_floating()):
                # the comparison's signedness as Hex-Rays read it from the jump (jl / jb ...): C++ would take it
                # from the operand types, which `_DWORD` leaves open
                try:
                    cmps.append([e.ea, CMPS[e.op], ida_lines.tag_remove(e.x.print1(None)),
                                 ida_lines.tag_remove(e.y.print1(None)), max(e.x.type.get_size(), e.y.type.get_size()),
                                 str(e.x.type), str(e.y.type)])
                except Exception: cmp_err[0] += 1
            if e.op in FCMPS and e.ea != idaapi.BADADDR and (e.x.type.is_floating() or e.y.type.is_floating()):
                # a float comparison: which outcomes (less, equal, greater, unordered) take its branch is in the
                # code at e.ea (fcom; fnstsw; test/and ah; jcc); Hex-Rays prints an ordered C operator, which
                # can differ for NaN. The translator rewrites each from the code
                try:
                    fcmps.append([e.ea, FCMPS[e.op], ida_lines.tag_remove(e.x.print1(None)),
                                  ida_lines.tag_remove(e.y.print1(None))])
                except Exception: cmp_err[0] += 1
            if e.op == ida_hexrays.cot_obj:
                oea = e.obj_ea; nm = ida_name.get_name(oea) or ('unk_%X' % oea)
                fn = ida_funcs.get_func(oea); is_func = bool(fn) and fn.start_ea == oea
                t = ida_typeinf.tinfo_t()
                if not ida_nalt.get_tinfo(t, oea): t = e.type
                try: printed = ida_lines.tag_remove(e.print1(None))
                except Exception: printed = nm
                pr = objs.get(nm, {}).get('printed', [])
                if printed not in pr: pr = pr + [printed]
                objs[nm] = {'ea': oea, 'func': is_func, 'type': str(t), 'printed': pr,
                            'size': t.get_size() if not is_func else 0,
                            'is_str': bool(ida_bytes.is_strlit(ida_bytes.get_flags(oea)))}
                if is_func: objs[nm]['purged'] = idc.get_func_attr(oea, idc.FUNCATTR_ARGSIZE)
                type_decl_closure(t, types)
            type_decl_closure(e.type, types)
            return 0
    V().apply_to(cf.body, None)
    for lv in cf.get_lvars(): type_decl_closure(lv.type(), types)
    type_decl_closure(cf.type, types)
    rec['objs'] = objs; rec['types'] = sorted(types); rec['calls'] = calls; rec['cmps'] = cmps; rec['fcmps'] = fcmps
    for v in calls.values(): STATS['calls_' + v[2]] = STATS.get('calls_' + v[2], 0) + 1
    STATS['cmps'] = STATS.get('cmps', 0) + len(cmps); STATS['fcmps'] = STATS.get('fcmps', 0) + len(fcmps); STATS['cmp_errors'] = STATS.get('cmp_errors', 0) + cmp_err[0]
    # IDA's stack pointer wherever it changes (compared with the depth measured by running the original)
    pfn = ida_funcs.get_func(ea); spd = []; last = None
    for item in (idautils.FuncItems(ea) if pfn else ()):
        v = idc.get_spd(item)
        if v is not None and v != last: spd.append([item, v]); last = v
    rec['spd'] = spd
    rec['purged'] = idc.get_func_attr(ea, idc.FUNCATTR_ARGSIZE)
    fd = ida_typeinf.func_type_data_t(); cf.type.get_func_details(fd)
    rec['cc'] = cc_name(fd); rec['ret'] = str(fd.rettype)
    rec['args'] = [[a.name, str(a.type), a.type.get_size(),
                    (str(a.type.get_pointed_object()) if a.type.is_ptr() else None),
                    (a.type.get_pointed_object().get_size() if a.type.is_ptr() else None)] for a in fd]
    return rec


def reexport(report):
    out = os.path.join(OUT_DIR, 'gfx_export.jsonl'); eas = DATA['export']; skipped = 0
    with open(out, 'w') as f:
        for i, ea in enumerate(eas):
            if ida_kernwin.user_cancelled(): log('export: cancelled at %d' % i); break
            if i % 10 == 0: ida_kernwin.replace_wait_box('Re-export %d of %d' % (i, len(eas)))
            try: rec = export_one(ea)
            except Exception as e: rec = {'ea': ea, 'skip': 'export error: %s' % e}
            skipped += 'skip' in rec
            f.write(json.dumps(rec) + '\n')
    report['export'] = {'file': out, 'functions': len(eas), 'skip': skipped}
    log('export: %d functions written to %s (%d marked skip)' % (len(eas), out, skipped))
    for k in ('calls_typed', 'calls_cast', 'cmps', 'fcmps', 'cmp_errors'): STATS.setdefault(k, 0)
    report['export']['stats'] = STATS
    log('export: calls typed in the IDB %(calls_typed)d, cast by Hex-Rays %(calls_cast)d; comparisons %(cmps)d integer, '
        '%(fcmps)d float (%(cmp_errors)d could not be printed)' % STATS)
    export_type_decls(report, out)


def export_type_decls(report, export_file):
    """gfx_types_game.h next to the export: IDA's own declarations (print_decls) of every type the exported
    functions use, so the translation compiles against the IDB the functions came from. The D3D8 types are
    left out: pipeline/xi_d3d8.hpp declares them (DATA['types_external'], its definitions)."""
    names = set()
    for l in open(export_file):
        names.update(json.loads(l).get('types', []))
    ext = set(DATA['types_external'])
    ordl = sorted({o for o in (ida_typeinf.get_type_ordinal(ida_typeinf.get_idati(), n) for n in names) if o})
    txt = idc.print_decls(','.join(str(o) for o in ordl), ida_typeinf.PDF_INCL_DEPS | ida_typeinf.PDF_DEF_FWD) or ''
    blocks = re.split(r'(?m)^(?=/\* \d+ \*/$)', txt)
    keep, dropped = [], []
    for b in blocks:
        m = (re.search(r'(?m)^(?:typedef\s+)?(?:struct|union|enum)\s+(?:__\w+(?:\(\d+\))?\s+)*(\w+)\s*(?::[^{\n]*)?\n?\{', b)
             or re.search(r'(?m)^typedef\s[^;]*?\b(\w+)\s*;', b))
        if m and m.group(1) in ext: dropped.append(m.group(1)); continue
        keep.append(b)
    out = os.path.join(OUT_DIR, 'gfx_types_game.h')
    open(out, 'w').write("// Game types exported from the IDB (IDA print_decls); D3D types come from xi_d3d8.hpp.\n"
                         "#pragma once\n" + ''.join(keep))
    report['types_header'] = {'file': out, 'types_used': len(names), 'blocks': len(keep), 'left_to_xi_d3d8': sorted(set(dropped))}
    log('types: %d declarations written to %s (%d D3D8 declarations left to xi_d3d8.hpp)' % (len(keep), out, len(set(dropped))))


def main():
    t0 = time.time(); report = {'sp': {}, 'reverted': {}, 'call_types': {}, 'conventions': {}}
    log('ffxi_ida_fix: IDA %s, IDB %s' % (idaapi.get_kernel_version(), idc.get_idb_path()))
    if not ida_hexrays.init_hexrays_plugin(): log('Hex-Rays decompiler is not available'); return
    ida_kernwin.show_wait_box('ffxi_ida_fix')
    try:
        for step in (apply_names, apply_facts, apply_types, apply_viewports, lambda: fix_conventions(report), lambda: apply_classes(report), lambda: ida_auto.auto_wait(),
                     lambda: revert(report), lambda: fix_sp(report), lambda: force_call_types(report), lambda: reexport(report)):
            try: step()
            except Exception: log('STEP FAILED:\n' + traceback.format_exc())
    finally:
        ida_kernwin.hide_wait_box()
        json.dump(report, open(os.path.join(OUT_DIR, 'ida_fix_report.json'), 'w'), indent=1)
        open(os.path.join(OUT_DIR, 'ida_fix_log.txt'), 'w').write('\n'.join(LOG) + '\n')
        log('ffxi_ida_fix: done in %.0f s; results in %s' % (time.time() - t0, OUT_DIR))


main()
